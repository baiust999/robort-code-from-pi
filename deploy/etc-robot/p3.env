# P3 watchdog configuration. Install to /etc/robot/p3.env.
# See pi/common/config.py:P3Config.from_env for the full option list.

PYTHON_BIN=/opt/robot/venv/bin/python
P1_CMD=/opt/robot/venv/bin/python -m p1_control.main
P2_CMD=/opt/robot/venv/bin/python -m p2_media.main

P1_HEALTH_URL=http://127.0.0.1:8080/health
P2_HEALTH_URL=http://127.0.0.1:8443/health

# Local Mesh Only is the primary deployment mode (Section 8.11.6). The
# internet overlay (cloudflared/TURN) is disabled by default.
ENABLE_OVERLAY=0

MESH_GATEWAY=192.168.10.1

ROBOT_ROOT=/
