# P1 control server configuration. Install to /etc/robot/p1.env.
# See pi/common/config.py:P1Config.from_env for the full option list.

P1_HOST=0.0.0.0
P1_PORT=8080

# Section 8.7.5/8.8 use /dev/ttyUSB0 for CH340-style clone boards; this Uno
# enumerates as /dev/ttyACM0 (ATmega16U2 USB) -- verify with `ls /dev/tty{USB,ACM}*`
# after plugging in the Arduino, and switch to /dev/ttyAMA0 if using the GPIO header.
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200

GPS_PORT=/dev/serial0
GPS_BAUD=9600

MOCK_HARDWARE=0

STUN_URL=stun:192.168.10.1:3478

# Key a dashboard must enter to drive, stop, or talk to the victim; without it
# a dashboard is a view-only observer. Also read by P2 (the watchdog unit
# loads every env file). Empty = nobody can control. Set the real value only
# in /etc/robot/p1.env, never in git. 5 wrong keys from one IP lock it out for
# 5 minutes (per service; restarting clears it).
CONTROLLER_KEY=

DASHBOARD_DIR=/opt/robot/dashboard/dist

TELEMETRY_LOG=1

ROBOT_ROOT=/
