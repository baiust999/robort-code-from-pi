# P2 media server configuration. Install to /etc/robot/p2.env.
# See pi/common/config.py:P2Config.from_env for the full option list.

P2_HOST=0.0.0.0
P2_PORT=8443

MOCK_HARDWARE=0

VIDEO_DEVICE=/dev/video0
AUDIO_DEVICE=default
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=10
VIDEO_BITRATE_KBPS=500

ROBOT_ROOT=/
