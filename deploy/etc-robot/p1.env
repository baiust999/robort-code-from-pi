# P1 control server configuration. Install to /etc/robot/p1.env.
# See pi/common/config.py:P1Config.from_env for the full option list.

P1_HOST=0.0.0.0
P1_PORT=8080

# Section 8.7.5/8.8 use /dev/ttyUSB0; verify against `ls /dev/ttyUSB*` after
# plugging in the Arduino, and switch to /dev/ttyAMA0 if using the GPIO header.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

GPS_PORT=/dev/serial0
GPS_BAUD=9600

MOCK_HARDWARE=0

STUN_URL=stun:192.168.10.1:3478

DASHBOARD_DIR=/opt/robot/dashboard/dist

TELEMETRY_LOG=1

ROBOT_ROOT=/
